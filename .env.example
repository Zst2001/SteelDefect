# 本地开发示例。复制为仓库根目录 .env 后按需修改。不要把真实密钥提交进 Git。

MYSQL_DSN=mysql+pymysql://lab:labdev_mysql@127.0.0.1:3307/steel_lab?charset=utf8mb4
MYSQL_ROOT_PASSWORD=labdev_root
MYSQL_DATABASE=steel_lab
MYSQL_USER=lab
MYSQL_PASSWORD=labdev_mysql

REDIS_QUEUE_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1

SECRET_KEY=change-me-local-dev-secret-not-for-production
SESSION_HOURS=24

# 模型适配助手用的对话接口（OpenAI 兼容）。不要把真实密钥提交进 Git。
# 百炼控制台：https://bailian.console.aliyun.com/  先测 qwen3.8-max，导师要换模型只改 LLM_MODEL。
LLM_API_KEY=
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-max
LLM_TIMEOUT_SEC=20
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

STORAGE_ROOT=storage
SEED_ON_START=true

SEED_ADVISOR_USERNAME=advisor
SEED_ADVISOR_PASSWORD=AdvisorDev!234
SEED_STUDENT_USERNAME=student
SEED_STUDENT_PASSWORD=StudentDev!234

MAX_UPLOAD_IMAGES=50
MAX_IMAGE_BYTES=20971520
COMPARE_JOB_TIMEOUT_SEC=7200
EVAL_JOB_TIMEOUT_SEC=7200
PERF_JOB_TIMEOUT_SEC=600
EVAL_MONTAGE_SAMPLES=8
CACHE_TASK_TTL_SEC=60
CACHE_MODELS_TTL_SEC=600

# Full NEU images/masks live here (or set an absolute path). Seeded read-only; not the official eval split.
NEU_FULL_ROOT=assets/datasets/neu

